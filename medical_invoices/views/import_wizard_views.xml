<odoo>
    <record id="view_prescription_import_wizard_form" model="ir.ui.view">
        <field name="name">medical.prescription.import.wizard.form</field>
        <field name="model">medical.prescription.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Prescriptions">
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename"/>
                    <field name="prescription_ids"/>
                    <field name="invoice_id"/>
                </group>
                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
